DEBUG=true
SECRET_KEY=change-me
# Postgres (Neon pooled string or local). Omit for SQLite fallback.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production (Vercel): DEBUG=false, SECRET_KEY, DATABASE_URL, ALLOWED_HOSTS=<api-host>,
# CORS_ALLOWED_ORIGINS=https://<web-host>, CSRF_TRUSTED_ORIGINS=https://<web-host>,
# CACHE_URL=dbcache://django_cache, SHOW_DEVELOPMENT_DATA=false
# Optional hardening: ADMIN_URL=some-private-path/ (must end with "/"), WEB_PROXY_SECRET (same value on the
# web project), CRON_SECRET, ANTHROPIC_API_KEY,
# SECURE_HSTS_INCLUDE_SUBDOMAINS / SECURE_HSTS_PRELOAD (see docs/SECURITY.md before enabling)
